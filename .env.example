# Server configuration
PORT=8000
HOST=0.0.0.0
# The submitted base URL ending in /a2a
PUBLIC_BASE_URL=http://localhost:8000/a2a

# Persistence database URL (SQLite default, or postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./a2a_invoice_agent.db

# Authentication: if set, incoming requests must supply this Bearer token (or one of comma-separated tokens)
# If empty, any non-empty Bearer token is accepted as an isolated principal
AUTH_BEARER_TOKEN=

# AI Model Configuration
TEST_MODE=true
AI_PROVIDER=generic_openai
AI_BASE_URL=https://aipipe.org/openai/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
